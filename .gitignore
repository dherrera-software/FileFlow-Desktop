# ============================================================
# FileFlow Desktop — .gitignore
# ============================================================

# ── Node / pnpm ─────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Vite / Frontend build ────────────────────────────────────
dist/
dist-ssr/
*.local

# ── Rust / Cargo ─────────────────────────────────────────────
src-tauri/target/
src-tauri/gen/schemas/

# ── Tauri build artifacts ────────────────────────────────────
# Los ejecutables finales en la raíz son artefactos — no subir binarios al repo
FileFlow.exe
FileFlow-Setup.exe
*.msi

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ───────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Archivos internos de desarrollo (no relevantes para el repo) ──
AGENTS.md
DEV_LOG.md
TODO.md

# ── Misc ─────────────────────────────────────────────────────
*.log
*.local
validation/
